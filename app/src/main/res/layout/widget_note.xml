<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/note_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:paddingStart="10dp"
    android:paddingTop="10dp"
    android:paddingEnd="10dp"
    android:paddingBottom="4dp">
    <LinearLayout
        android:id="@+id/note_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingBottom="6dp">
        <TextView
            android:id="@+id/note_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_note_title"
            android:textColor="@color/widget_text"
            android:textSize="18sp"
            android:textStyle="bold" />
        <ImageView
            android:id="@+id/note_open"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/widget_add_bg"
            android:contentDescription="@string/widget_open_note"
            android:padding="7dp"
            android:src="@drawable/ic_widget_open" />
    </LinearLayout>
    <ListView
        android:id="@+id/note_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:scrollbarStyle="outsideOverlay" />
    <TextView
        android:id="@+id/note_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:padding="12dp"
        android:text="@string/widget_note_pick"
        android:textColor="@color/widget_subtext"
        android:textSize="15sp"
        android:visibility="gone" />
</LinearLayout>
