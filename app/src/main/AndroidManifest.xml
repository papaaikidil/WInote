<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Untuk mengunduh kamus tulisan tangan dan komponen hapus latar. Catatan tidak pernah dikirim ke internet oleh aplikasi ini. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Untuk rekam suara dan dikte. Hanya dipakai saat tombol suara diketuk. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Face Paint: kamera depan untuk menemukan wajah (diolah di perangkat). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.front" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Supaya aplikasi bisa menemukan layanan pengenal suara (Android 11 ke atas). -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <!-- Ruang gambar memakai OpenGL ES 3; aplikasi tetap bisa dipasang di perangkat tanpanya. -->
    <uses-feature android:glEsVersion="0x00030000" android:required="false" />

    <application
        android:name=".HanaApplication"
        android:allowBackup="true"
        android:largeHeap="true"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.HanaNote">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|density|uiMode|navigation"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Widget layar utama: catatan terbaru, dan satu catatan pilihan. -->
        <receiver
            android:name=".widget.RecentNotesWidget"
            android:exported="false"
            android:label="@string/widget_recent_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_recent_info" />
        </receiver>
        <receiver
            android:name=".widget.NoteWidget"
            android:exported="false"
            android:label="@string/widget_note_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_note_info" />
        </receiver>
        <activity
            android:name=".widget.NoteWidgetConfigActivity"
            android:exported="true"
            android:label="@string/widget_note_label"
            android:theme="@style/Theme.HanaNote">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
        <!-- Isi daftar widget yang bisa digulir. -->
        <service
            android:name=".widget.RecentNotesService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />
        <service
            android:name=".widget.NoteWidgetService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />
        <!-- Ketukan butir widget (centang tanpa membuka aplikasi): tidak terlihat dan langsung selesai. -->
        <activity
            android:name=".widget.WidgetActionActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity="id.hananote.widgetaction"
            android:theme="@android:style/Theme.NoDisplay" />

        <!-- Komponen hapus latar diunduh otomatis oleh Layanan Google Play setelah aplikasi dipasang. -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="subject_segment" />

        <!-- Ruang gambar (mesin Goresan): kanvas berlapis, kuas, Alpha Lock, ColorDrop. -->
        <!-- Tugas sendiri: kembali ke WInote lewat ikon aplikasi tidak menutup kanvas yang sedang dikerjakan. -->
        <activity
            android:name="id.goresan.DrawActivity"
            android:label="WInote Gambar"
            android:taskAffinity="id.hananote.gambar"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|density|uiMode|navigation"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Goresan" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/share_paths" />
        </provider>
    </application>
</manifest>
